<controls:ProWindow x:Class="MikaelsReviewerQcToolbar.DuplicateVertex.DuplicateVertexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:qc="clr-namespace:MikaelsReviewerQcToolbar.Common"
        mc:Ignorable="d"
        Title="Vertex Tolerance Check" Height="730" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Finds vertices (within the same part of a polyline/polygon feature) that sit closer to another vertex than the tolerance. BELOW = closer than tolerance minus the margin. AT TOLERANCE = within plus or minus the margin of the tolerance, i.e. cutting it close. Tolerance is in the layer's own units (shown in the label)."/>

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,8,6" Text="Input Layer:"/>
        <ComboBox x:Name="LayerCombo" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,6"/>

        <TextBlock x:Name="ToleranceLabel" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,8,6" Text="Tolerance:"/>
        <TextBox x:Name="ToleranceTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,6" Text="1.5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,8,6" Text="At-tolerance margin (+/-):"/>
        <TextBox x:Name="MarginTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,6" Text="0.001"/>

        <CheckBox x:Name="BelowCheck" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,2" IsChecked="True"
                  Content="Report vertices below the tolerance"/>
        <CheckBox x:Name="AtCheck" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,2,0,6" IsChecked="True"
                  Content="Report vertices at the tolerance (cutting it close)"/>

        <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,8,6" Text="Vertex Points Output:"/>
        <TextBox x:Name="VertexOutputTextBox" Grid.Row="6" Grid.Column="1" Margin="0,6,6,6" VerticalContentAlignment="Center"/>
        <Button x:Name="VertexBrowseButton" Grid.Row="6" Grid.Column="2" Content="Browse..." Padding="8,2" Margin="0,6,0,6" Click="VertexBrowseButton_Click"/>

        <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,8,6" Text="Flagged Features Output:"/>
        <TextBox x:Name="OutputPathTextBox" Grid.Row="7" Grid.Column="1" Margin="0,6,6,6" VerticalContentAlignment="Center"/>
        <Button x:Name="BrowseButton" Grid.Row="7" Grid.Column="2" Content="Browse..." Padding="8,2" Margin="0,6,0,6" Click="BrowseButton_Click"/>

        <CheckBox x:Name="UseDefaultGdbCheck" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,6"
                  Content="Use project default geodatabase for the vertex points output"/>

        <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,4" Text="Log:"/>
        <Grid Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <qc:QcProgressPanel x:Name="ProgressPanel" Grid.Row="0"/>
            <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
                <wfi:WindowsFormsHost x:Name="LogHost"/>
            </Border>
        </Grid>

        <StackPanel Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="RunButton" Content="Run" Width="90" Padding="4" Margin="0,0,8,0" Click="RunButton_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Padding="4" Margin="0,0,8,0" Click="CancelButton_Click" Visibility="Collapsed"/>
            <Button x:Name="CloseButton" Content="Close" Width="90" Padding="4" Click="CloseButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</controls:ProWindow>

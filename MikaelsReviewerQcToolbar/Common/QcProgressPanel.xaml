<UserControl x:Class="MikaelsReviewerQcToolbar.Common.QcProgressPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,4,0,8">
        <Grid>
            <ProgressBar x:Name="Bar" Height="20" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="PercentText" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Text="0%"/>
        </Grid>
        <TextBlock x:Name="StepText" Margin="0,6,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="LayerText" TextWrapping="Wrap"/>
        <TextBlock x:Name="PhaseText" TextWrapping="Wrap"/>
        <TextBlock x:Name="RecordText" TextWrapping="Wrap"/>
        <TextBlock x:Name="TimeText" Margin="0,4,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>

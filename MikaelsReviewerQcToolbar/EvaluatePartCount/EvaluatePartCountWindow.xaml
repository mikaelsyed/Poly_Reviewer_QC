<controls:ProWindow x:Class="MikaelsReviewerQcToolbar.EvaluatePartCount.EvaluatePartCountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:qc="clr-namespace:MikaelsReviewerQcToolbar.Common"
        mc:Ignorable="d"
        Title="Evaluate Part Count" Height="610" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Flags features whose number of separate, disconnected parts matches the query below (e.g. Greater Than 1 finds multipart features). Polygon holes are not counted as parts. Works on polyline and polygon layers."/>

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,8,6" Text="Input Layer:"/>
        <ComboBox x:Name="LayerCombo" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,6"/>

        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,8,6" Text="Number of Parts:"/>
        <ComboBox x:Name="OperatorCombo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,6"/>

        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,8,6" Text="Value:"/>
        <TextBox x:Name="Value1TextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,6" Text="1"/>

        <TextBlock x:Name="Value2Label" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,8,6" Text="And:"/>
        <TextBox x:Name="Value2TextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,6" Text="2"/>

        <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,8,6" Text="Output Feature Class:"/>
        <TextBox x:Name="OutputPathTextBox" Grid.Row="5" Grid.Column="1" Margin="0,6,6,6" VerticalContentAlignment="Center"/>
        <Button x:Name="BrowseButton" Grid.Row="5" Grid.Column="2" Content="Browse..." Padding="8,2" Margin="0,6,0,6" Click="BrowseButton_Click"/>

        <CheckBox x:Name="UseDefaultGdbCheck" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,6"
                  Content="Use project default geodatabase for output"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,4" Text="Log:"/>
        <Grid Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <qc:QcProgressPanel x:Name="ProgressPanel" Grid.Row="0"/>
            <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
                <wfi:WindowsFormsHost x:Name="LogHost"/>
            </Border>
        </Grid>

        <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="RunButton" Content="Run" Width="90" Padding="4" Margin="0,0,8,0" Click="RunButton_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Padding="4" Margin="0,0,8,0" Click="CancelButton_Click" Visibility="Collapsed"/>
            <Button x:Name="CloseButton" Content="Close" Width="90" Padding="4" Click="CloseButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</controls:ProWindow>
